{
  "schema": "https://aifreedomtrust.org/schemas/aift.repo.schema.json",
  "name": "AIFT-Runtime",
  "layer": "runtime",
  "role": "local runtime intelligence, repository awareness, graph, health, governed synchronization, and execution services",
  "federation": {
    "workspace": "AIFT",
    "controlPlane": "AIFT-OS",
    "doctrine": "AI-Freedom-Trust/SOP-ALOHA-001.md"
  },
  "commands": {
    "health": "./health.sh",
    "bootstrap": "./bootstrap.sh",
    "verify": "bash -c 'source ./runtime/verify.sh && aift_verify'",
    "doctor": "bash -c 'source \"$HOME/AIFT/runtime/common.sh\" && source ./runtime/doctor.sh && aift_doctor'",
    "status": "bash -c 'source \"$HOME/AIFT/runtime/common.sh\" && source ./runtime/status.sh && aift_status'"
  },
  "standards": {
    "localFirst": true,
    "inspectable": true,
    "sovereignByDefault": true,
    "aiBehindProviderInterfaces": true,
    "verifyBeforeMutation": true
  }
}
